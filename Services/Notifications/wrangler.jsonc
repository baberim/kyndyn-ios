{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyndyn-notifications",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "SERVICE_STAGE": "delivery",
    "APPLE_TEAM_ID": "96TZPZ6H89",
    "APNS_TOPIC": "com.kyndynfamily.kyndyn",
    "APNS_SANDBOX_KEY_ID": "2K8PCHCCV8",
    "APNS_PRODUCTION_KEY_ID": "G6L8MSV9F4"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kyndyn-notifications-db",
      "database_id": "47479a8c-276b-4de3-b95e-cbfe13c1f777",
      "migrations_dir": "migrations"
    }
  ]
}
